<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/selector_ios_card"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶栏状态与学科 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWrongSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ios_badge_purple"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="数学"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWrongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="累计做错：2 次"
            android:textColor="@color/ios_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMasterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 重点复习"
            android:textColor="@color/ios_orange"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 题目内容 -->
    <TextView
        android:id="@+id/tvWrongQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="题干内容..."
        android:textColor="@color/ios_text_primary"
        android:textSize="15sp" />

    <!-- 解析 -->
    <TextView
        android:id="@+id/tvWrongExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="解析：..."
        android:textColor="@color/ios_text_secondary"
        android:textSize="13sp" />
</LinearLayout>