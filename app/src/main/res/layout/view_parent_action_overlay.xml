<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2080C14"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ios_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓 家长验证通过"
            android:textColor="@color/ios_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParentActionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="请选择操作"
            android:textColor="@color/ios_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/btnParentResetPenalty"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/selector_ios_row"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="清除惩罚并换新题（重置作答次数）"
                android:textColor="@color/ios_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ios_separator" />

            <TextView
                android:id="@+id/btnParentUnlock"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/selector_ios_row"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="直接解锁电视并重新开始计时"
                android:textColor="@color/ios_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ios_separator" />

            <TextView
                android:id="@+id/btnParentActionCancel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/selector_ios_row"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="取消，返回"
                android:textColor="@color/ios_text_secondary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
